#!/usr/bin/env bash
#
# pre-push: refuse a branch that carries another branch's commits.
#
# This is where the MGIT-142 tripwire fires, and the timing is the point. The
# incident it exists for (9abf4ce: a one-file CI branch that inherited 531
# lines across six files from an unmerged task branch) was visible in the pull
# request's own diff and merged anyway. A check that runs at review time is a
# check that competes with a reviewer's attention; this one runs before the
# branch reaches the remote, so the pull request never gets to exist.
#
# Install:  make install-hooks     (sets core.hooksPath to scripts/hooks)
# Bypass:   git push --no-verify   (the CI backstop still checks the PR)
#
# TWO DOORS, deliberately different. The guard exits 2 when it REFUSES a
# branch, and that blocks the push. It exits 1 when it could not run the check
# at all (it could not open the repository, could not resolve the branch); that
# is reported and does NOT block, the same way a missing Go toolchain is
# handled below. A check that cannot run is an absence of evidence, not a
# refusal, and CI's "Branch scope" job re-runs the guard on the pull request
# either way (MGIT-182: for ten days every push from a linked worktree was
# refused as "reference not found" — the guard's own defect, read as a verdict).
#
# Refs: MGIT-142, MGIT-182
set -euo pipefail

root=$(git rev-parse --show-toplevel)
zero='0000000000000000000000000000000000000000'
status=0
guarddir=$(mktemp -d)
guard="$guarddir/branchguard"
trap 'rm -rf "$guarddir"' EXIT

if ! command -v go >/dev/null 2>&1; then
	echo "pre-push: Go is not on PATH, so the branch-scope check did not run." >&2
	echo "          CI still checks it on the pull request. Refs: MGIT-142" >&2
	exit 0
fi

# stdin carries one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha _remote_ref _remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # a deletion pushes nothing to check
	case "$local_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac
	branch=${local_ref#refs/heads/}
	# BUILD, THEN RUN. `go run` reports every non-zero program exit as its own
	# exit 1 (printing "exit status N"), so through it a refusal (2) and a
	# could-not-run (1) are the same number — and the first version of this
	# door let a refused branch through on exactly that. The build is cached,
	# so this costs nothing after the first push.
	if ! (cd "$root" && go build -o "$guard" ./scripts/branchguard); then
		echo "pre-push: the branch-scope guard did not build, so it did not check $branch." >&2
		echo "          CI still checks it on the pull request. Refs: MGIT-182" >&2
		continue
	fi
	rc=0
	"$guard" --repo "$root" --branch "$branch" || rc=$?
	case "$rc" in
	0) ;;
	2) status=1 ;; # refused: the branch carries another branch's commits
	*)
		echo "pre-push: the branch-scope check could not run on $branch (branchguard exit $rc)," >&2
		echo "          so it did not check it. CI still checks it on the pull request. Refs: MGIT-182" >&2
		;;
	esac
done

exit "$status"
