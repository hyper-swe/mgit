# SOUP pins for the reproducible sandbox guest-image build (MGIT-30, FR-17.31).
#
# Every external input is pinned by a content digest (image @sha256, tarball
# sha256) and every non-deterministic build input is fixed (clock, build
# user/host, filesystem UUID). The build VERIFIES against these pins and fails
# LOUD on drift, so a mirror or base-image swap can never silently produce a
# different kernel or rootfs. Output digests are recorded in *_SHA256 after a
# reproducible build so a re-build (or CI) can assert bit-for-bit equality.
#
# Sourced by the build scripts; keep it plain KEY=VALUE (no expansion needed).

# --- Reproducible-build determinism knobs ------------------------------------
# Fixed clock: 2026-07-21T00:00:00Z. Feeds SOURCE_DATE_EPOCH, the kernel
# KBUILD_BUILD_TIMESTAMP, and the ext4 superblock/inode timestamps.
SOURCE_DATE_EPOCH=1784592000
KBUILD_BUILD_USER=mgit
KBUILD_BUILD_HOST=sandbox-image
# Fixed ext4 filesystem UUID ("mgit" + zeros): a random UUID would defeat
# rootfs reproducibility.
ROOTFS_UUID=6d676974-0000-4000-8000-000000000001

# --- Pinned toolchain (by image digest) --------------------------------------
# The builder base and busybox are pinned by digest so the compiler/libc and
# the guest shell are byte-identical across machines and over time.
# debian:bookworm-slim builder, pinned per-arch (the index digest was
# 7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818; per-arch
# digests avoid the `docker run --platform X image@<index>` overwrite error).
BUILDER_AMD64=debian@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e
BUILDER_ARM64=debian@sha256:9b67294679b30e5d6ab257b40594feeb4a4b81f7fcf4131f4decf0d6a212a9b0
# busybox:musl, pinned by PER-ARCH manifest digest (the multi-arch index digest
# was 8635836765b0c4c43970660219739baa58b0883c2e429e4b8918f7dd1519455c;
# `docker create --platform X image@<index>` is unreliable, so we pin the exact
# arch image and extract it without --platform).
BUSYBOX_AMD64=busybox@sha256:ffcc8d72c1b3749dd2240e27f79b987eb227538835a2675b1d5849b053a39195
BUSYBOX_ARM64=busybox@sha256:8731bd0653b058cb81cdafffea7807c9b8b9168d741958ea95a3d1dfbcaab149

# --- vz (Apple Virtualization.framework) kernel: BUILT from source -----------
# Apple's Virtualization.framework presents virtio over PCI, so the guest
# kernel needs VIRTIO_PCI/BLK/CONSOLE/NET/VSOCKETS/FS + FUSE + OVERLAY + EXT4
# + PCI_HOST_GENERIC built in (see vz-kernel.config). The firecracker aarch64
# kernel is virtio-MMIO-only and does NOT work under vz.
#
# Source durability note: kernel.org rotates point releases off its mirrors
# over months. The sha256 pin makes a rotation fail LOUD (not silently wrong);
# for long-term reproducibility, vendor the tarball (VZ_KERNEL_SRC=<path>) — the
# published image bundle (MGIT-61.2) is the durable artifact regardless.
VZ_KERNEL_VERSION=6.12.74
VZ_KERNEL_URL=https://mirrors.edge.kernel.org/pub/linux/kernel/v6.x/linux-6.12.74.tar.xz
VZ_KERNEL_SHA256=3b56eeb1dc9a437f189ca56b823be3769994f59a4ea0895b08ec0d20acaca13e
# Recorded after the first reproducible build (build-kernel-vz.sh asserts it):
VZ_KERNEL_IMAGE_SHA256=e56aacd1dea0a57135fb57f3f43c77f15dbea0a6afe352994b25b4d19bc56d84

# --- firecracker (Linux/KVM) kernel: VENDORED (pin URL + sha256) -------------
# The firecracker backend uses a firecracker-compatible vmlinux. We vendor the
# firecracker-ci prebuilt per arch, pinned by sha256. Provenance: firecracker
# CI v1.10, Linux 5.10.223 — the SAME x86_64 kernel the KVM box boot-validated
# (MGIT-58/59). The publish step (MGIT-61.2) re-hosts these as release assets
# so `mgit sandbox image install` fetches only from the mgit release. A
# reproducible-by-us firecracker kernel build (like the vz kernel) is a
# follow-up; the sha256 pin is the integrity anchor meanwhile.
FC_KERNEL_AMD64_URL=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.10/x86_64/vmlinux-5.10.223
FC_KERNEL_AMD64_SHA256=22847375721aceea63d934c28f2dfce4670b6f52ec904fae19f5145a970c1e65
FC_KERNEL_ARM64_URL=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.10/aarch64/vmlinux-5.10.223
FC_KERNEL_ARM64_SHA256=eb5d95ac8a67f7a86acf0cb35625633713ad5170b56de8617808d0e18bb832ec

# --- firecracker VMM binary: VENDORED (pin URL + sha256) ---------------------
# mgit execs firecracker; it does not build it. So the VMM is a SOUP input on
# the same footing as the guest kernel above, pinned by the sha256 of the
# upstream release archive. fetch-firecracker.sh verifies this before
# installing, so a mirror swap fails loud instead of silently changing the
# hypervisor a containment gate runs against. Refs: MGIT-78, FR-17.15
FC_VMM_VERSION=v1.13.2
FC_VMM_AMD64_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.13.2/firecracker-v1.13.2-x86_64.tgz
FC_VMM_AMD64_SHA256=a6db3b451f500dfd82989447febf54b5c8bb8929e4ee7c7f84a9695f130da547
FC_VMM_ARM64_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.13.2/firecracker-v1.13.2-aarch64.tgz
FC_VMM_ARM64_SHA256=a64c0b913b29b8ea4b5990ecb94a92cb7cb4eb850015b69aa1680d25d9cb41bf

# --- libkrun / libkrunfw (the linked VMM): BUILT from source, PINNED ---------
# No Ubuntu release packages either library and there is no Linux tap, so the
# Linux libkrun backend is always a from-source build — which left the version
# an unpinned moving target until MGIT-87. It moved: upstream libkrun after
# v1.19.4 replaced krun_set_workdir with a stub returning -ENOTSUP on every
# non-aws-nitro build, and the first real Linux boot attempt died on exactly
# that ("libkrun error -95", CI run 31482480288). These are the versions
# Homebrew ships — the same pair the macOS column is validated against — so the
# two platforms are compared on the same library rather than on whatever
# upstream main happened to be that morning. Consumed by build-libkrun.sh.
# Refs: MGIT-87, ADR-010, MGIT-61.8
LIBKRUN_VERSION=v1.19.4
LIBKRUNFW_VERSION=v5.5.0

# --- Guest kernel command lines ----------------------------------------------
# The registered image carries its own cmdline, and an image registered WITHOUT
# one boots a kernel with no root= and no init=: firecracker starts, the vCPUs
# run, and the guest never reaches mgit-guest, so the only symptom is
# "guest vsock not ready within 15s". Keeping these here (rather than only
# inside build-bundle.sh) gives every caller — the bundle builder, CI, and a
# human following docs/release/RELEASE-CHECKLIST.md — the same string.
# Refs: MGIT-78, MGIT-30
FC_CMDLINE="console=ttyS0 reboot=k panic=1 pci=off ipv6.disable=1 random.trust_cpu=on root=/dev/vda ro rootfstype=ext4 init=/sbin/mgit-guest"
VZ_CMDLINE="console=hvc0 root=/dev/vda ro rootfstype=ext4 init=/sbin/mgit-guest"
