# Verification tools the guest base carries (FEAT-6.104). Plain KEY=VALUE,
# sourced by guest-tools-selftest.sh and the base build. Every value was read
# from the publisher's own checksum source, never typed from memory:
#   Go            go.dev/dl JSON
#   Node          nodejs.org SHASUMS256.txt
#   golangci-lint the release checksums.txt
#   JRE           the Adoptium (Temurin) assets API
#   TLC           sha256 of the release asset, computed once at pin time
#   govulncheck   the go.sum hash of the golang.org/x/vuln module (no binary
#                 release; the base builds it from source with GOFLAGS=-mod=mod
#                 and GONOSUMDB unset, so the module cache must match this hash)
# The guest runs with no network and no credentials; nothing here is fetched
# at run time. Go must equal the go directive in go.mod; a bump moves both.

GO_VERSION=1.26.9
GO_SHA256_AMD64=42d158b4d8f7b61ac0a830567c940a86098fb7aac52e467a5ebec03ef5cc2f8d
GO_SHA256_ARM64=4a97373d49fcacdcf3694fea368a500b00ee3e963974f3e7514132717632f052

# Temurin LTS JRE (>= 17 required; 21 is the current LTS)
JRE_VERSION=21.0.12+101
JRE_SHA256_AMD64=2413149700df0f7d440500a84a8f764c535f21e5a5e87d38328b64eec2c5b500
JRE_SHA256_ARM64=14be1f35ebdbd1f6e8d57eb911a3ffb74d6d9aa255abc5daf2b1302002cf2cf2

# TLC model checker: tla2tools.jar from the tlaplus v1.7.4 release (stable)
TLC_VERSION=1.7.4
TLC_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88

GOLANGCI_LINT_VERSION=2.11.4
GOLANGCI_LINT_SHA256_AMD64=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
GOLANGCI_LINT_SHA256_ARM64=3bcfa2e6f3d32b2bf5cd75eaa876447507025e0303698633f722a05331988db4

GOVULNCHECK_VERSION=1.8.0
GOVULNCHECK_MODULE_H1=h1:clG4qBU6zH5VKjti8n5j8BBuYzoSha392xXMkXS351U=

NODE_VERSION=22.23.3
NODE_SHA256_AMD64=df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de
NODE_SHA256_ARM64=a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f

# --- Download names (the version strings above are NOT always the URL form) --
# Adoptium's semver 21.0.12+101 is the release jdk-21.0.12.1+1; a URL built
# from the semver returns 404.
JRE_RELEASE=jdk-21.0.12.1+1
JRE_ASSET_AMD64=OpenJDK21U-jre_x64_linux_hotspot_21.0.12.1_1.tar.gz
JRE_ASSET_ARM64=OpenJDK21U-jre_aarch64_linux_hotspot_21.0.12.1_1.tar.gz
# The Node sums are for the .tar.xz assets.
NODE_ASSET_AMD64=node-v22.23.3-linux-x64.tar.xz
NODE_ASSET_ARM64=node-v22.23.3-linux-arm64.tar.xz
